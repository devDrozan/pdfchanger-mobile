{
  "name": "pdfchanger-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [".*"]
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/ios/patch-expo-modules-core.mjs",
    "start": "expo start --dev-client",
    "android": "bash scripts/run-android.sh",
    "ios": "bash scripts/run-ios.sh",
    "ios:setup": "bash scripts/setup-ios.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "bash scripts/verify.sh",
    "android:build": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "expo": "58.0.19",
    "expo-dev-client": "58.0.15",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.12",
    "expo-image-manipulator": "58.0.15",
    "expo-image-picker": "58.0.10",
    "expo-sharing": "58.0.20",
    "expo-splash-screen": "58.0.12",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
