{
  "expo": {
    "name": "PDF Changer",
    "slug": "pdfchanger",
    "scheme": "pdfchanger",
    "version": "0.1.0",
    "icon": "./assets/logo.png",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pdfchanger.mobile",
      "appleTeamId": "6BJ6GQU845"
    },
    "android": {
      "package": "com.pdfchanger.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#18332D"
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F5",
          "image": "./assets/logo.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PDF Changer to import photos for PDFs.",
          "cameraPermission": "Allow PDF Changer to photograph document pages.",
          "microphonePermission": false
        }
      ],
      
[
  "react-native-google-mobile-ads",
  {
    "androidAppId": "ca-app-pub-7752680457121386~2062810026"
  }
]

    ],
    "extra": {
      "eas": {
        "projectId": "65da324d-5886-4f75-8caa-33a3b91f5fe7"
      }
    }
  }
}
